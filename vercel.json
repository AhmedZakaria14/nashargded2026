{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/((?!styles.css|app.js|robots.txt|sitemap.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/styles.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}