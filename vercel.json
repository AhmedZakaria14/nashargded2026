{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/home-v3.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/exact-source/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/assets/elnashargroup-logo-v3.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/elnashargroup-icon-v3.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/home-v3.html" },

    { "source": "/wp-content/uploads/:year/:month/Adsela-new-logo2.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/Adsela-new-logo2.png.webp", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/adsela-new-logo.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/Adsela-Logo.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/logo-png-white-01.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/adsela-icon-footer.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/adsela-icon-footer.png.webp", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/adsela-icon-footer11.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/logo-adsela-half.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/logo-adsela-half.png.webp", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/logo-adsela-half-right.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/logo-adsela-half-right.png.webp", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/cropped-fav-icon-1-32x32.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/wp-content/uploads/:year/:month/cropped-fav-icon-1-192x192.png", "destination": "/assets/elnashargroup-icon-v3.svg" },

    { "source": "/origin/wp-content/uploads/:year/:month/Adsela-new-logo2.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/Adsela-new-logo2.png.webp", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/adsela-new-logo.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/Adsela-Logo.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/logo-png-white-01.png", "destination": "/assets/elnashargroup-logo-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/adsela-icon-footer.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/adsela-icon-footer.png.webp", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/adsela-icon-footer11.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/logo-adsela-half.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/logo-adsela-half.png.webp", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/logo-adsela-half-right.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/logo-adsela-half-right.png.webp", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/cropped-fav-icon-1-32x32.png", "destination": "/assets/elnashargroup-icon-v3.svg" },
    { "source": "/origin/wp-content/uploads/:year/:month/cropped-fav-icon-1-192x192.png", "destination": "/assets/elnashargroup-icon-v3.svg" },

    { "source": "/exact-source/", "destination": "/index.html" },
    { "source": "/origin/:path*", "destination": "https://adselams.com/:path*" },

    { "source": "/about-us/", "destination": "/spa.html" },
    { "source": "/services/", "destination": "/spa.html" },
    { "source": "/seo/", "destination": "/spa.html" },
    { "source": "/digital-ads-2/", "destination": "/spa.html" },
    { "source": "/social-media/", "destination": "/spa.html" },
    { "source": "/website-dev/", "destination": "/spa.html" },
    { "source": "/e-commerce-solutions/", "destination": "/spa.html" },
    { "source": "/creatives-designs/", "destination": "/spa.html" },
    { "source": "/motion-graphic/", "destination": "/spa.html" },
    { "source": "/mobile-application/", "destination": "/spa.html" },
    { "source": "/influencers-marketing/", "destination": "/spa.html" },
    { "source": "/portfolio/", "destination": "/spa.html" },
    { "source": "/blog/", "destination": "/spa.html" },
    { "source": "/blog/:path*", "destination": "/spa.html" },
    { "source": "/contact-us/", "destination": "/spa.html" },
    { "source": "/faq/", "destination": "/spa.html" },
    { "source": "/careers/", "destination": "/spa.html" },
    { "source": "/privacy-policy/", "destination": "/spa.html" },
    { "source": "/en/", "destination": "/spa.html" },

    { "source": "/wp-content/plugins/:path*", "destination": "https://adselams.com/wp-content/plugins/:path*" },
    { "source": "/wp-content/themes/:path*", "destination": "https://adselams.com/wp-content/themes/:path*" },
    { "source": "/wp-content/uploads/:path*", "destination": "https://adselams.com/wp-content/uploads/:path*" },
    { "source": "/wp-content/cache/:path*", "destination": "https://adselams.com/wp-content/cache/:path*" },
    { "source": "/wp-includes/:path*", "destination": "https://adselams.com/wp-includes/:path*" },
    { "source": "/fonts.gstatic.com/:path*", "destination": "https://fonts.gstatic.com/:path*" }
  ]
}
